   "source": [
    "import pandas as pd\n",
    "\n",
    "# ========== 1. 筛选有效订单 ==========\n",
    "# 只保留已送达的订单（因为我们要分析配送时长）\n",
    "df_orders_clean = df_orders[df_orders['order_status'] == 'delivered'].copy()\n",
    "print(\"剔除未送达订单后，订单数:\", df_orders_clean.shape)\n",
    "\n",
    "# ========== 2. 时间字段转 datetime ==========\n",
    "date_cols_orders = [\n",
    "    'order_purchase_timestamp', 'order_approved_at',\n",
    "    'order_delivered_carrier_date', 'order_delivered_customer_date',\n",
    "    'order_estimated_delivery_date'\n",
    "]\n",
    "for col in date_cols_orders:\n",
    "    df_orders_clean[col] = pd.to_datetime(df_orders_clean[col])\n",
    "\n",
    "# ========== 3. 衍生新字段 ==========\n",
    "# 下单年月（用于趋势分析）\n",
    "df_orders_clean['order_purchase_year_month'] = df_orders_clean['order_purchase_timestamp'].dt.to_period('M')\n",
    "\n",
    "# 配送天数（实际送达 - 下单时间）\n",
    "df_orders_clean['delivery_days'] = (df_orders_clean['order_delivered_customer_date'] - df_orders_clean['order_purchase_timestamp']).dt.days\n",
    "\n",
    "# 是否延迟送达（实际送达 > 预计送达 为 1，否则 0）\n",
    "df_orders_clean['is_late'] = (df_orders_clean['order_delivered_customer_date'] > df_orders_clean['order_estimated_delivery_date']).astype(int)\n",
    "\n",
    "# ========== 4. 过滤异常数据 ==========\n",
    "# 过滤配送天数为负数的（极小概率）以及超级离谱的异常值（比如超过60天，大促期间可能，但为了分析排除极端）\n",
    "df_orders_clean = df_orders_clean[(df_orders_clean['delivery_days'] >= 0) & (df_orders_clean['delivery_days'] <= 60)]\n",
    "print(\"剔除极端值后，订单数:\", df_orders_clean.shape)\n",
    "\n",
    "# ========== 5. 商品表缺失值填充 ==========\n",
    "df_products_clean = df_products.copy()\n",
    "# 类目缺失填充为 'unknown'\n",
    "df_products_clean['product_category_name'] = df_products_clean['product_category_name'].fillna('unknown')\n",
    "\n",
    "# ========== 6. 多表合并（核心） ==========\n",
    "# 以订单表为主表\n",
    "# 先合并评价表（一对一）\n",
    "df_merged = df_orders_clean.merge(df_reviews, on='order_id', how='left')\n",
    "\n",
    "# 再合并明细表（一对多，注意这里会导致数据膨胀，这是正常的，因为我们后续可以按order_id聚合）\n",
    "df_merged = df_merged.merge(df_order_items, on='order_id', how='left')\n",
    "\n",
    "# 最后合并商品表（多对一）\n",
    "df_merged = df_merged.merge(df_products_clean, on='product_id', how='left')\n",
    "\n",
    "# 检查合并后总表形状\n",
    "print(\"合并后总表形状:\", df_merged.shape)\n",
    "print(\"合并后总表列名:\", df_merged.columns.tolist())\n",
    "\n",
    "# ========== 7. 导出为 clean_data.csv ==========\n",
    "df_merged.to_csv(\"clean_data.csv\", index=False)\n",
    
   ]
  },
