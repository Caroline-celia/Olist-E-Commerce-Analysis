    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 设置中文字体\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei'] \n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 1. 读取干净数据\n",
    "df_merged = pd.read_csv(\"clean_data.csv\")\n",
    "df_order_level = df_merged.drop_duplicates(subset=['order_id']).copy()\n",
    "\n",
    "# 2. 创建 2x2 画板\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "# ========== 分析1：订单时间趋势 ==========\n",
    "trend_data = df_order_level.groupby('order_purchase_year_month')['order_id'].count()\n",
    "axes[0, 0].plot(trend_data.index.astype(str), trend_data.values, marker='o', color='b')\n",
    "axes[0, 0].set_title('1. 订单时间趋势（按月订单量变化）')\n",
    "axes[0, 0].set_xlabel('下单年月')\n",
    "axes[0, 0].set_ylabel('订单量')\n",
    "axes[0, 0].tick_params(axis='x', rotation=45)\n",
    "\n",
    "# ========== 分析2：物流分析（不同品类的平均配送时长Top10） ==========\n",
    "cat_delivery = df_merged[df_merged['product_category_name'] != 'unknown'].groupby('product_category_name')['delivery_days'].mean().sort_values(ascending=False).head(10)\n",
    "sns.barplot(x=cat_delivery.values, y=cat_delivery.index, ax=axes[0, 1], palette='Reds_r')\n",
    "axes[0, 1].set_title('2. 物流分析：平均配送天数最长的10个品类')\n",
    "axes[0, 1].set_xlabel('平均配送天数')\n",
    "\n",
    "# ========== 分析3：评分分析（评分分布） ==========\n",
    "sns.countplot(data=df_order_level, x='review_score', ax=axes[1, 0], palette='viridis')\n",
    "axes[1, 0].set_title('3. 评分分析：用户评分分布')\n",
    "axes[1, 0].set_xlabel('评分')\n",
    "axes[1, 0].set_ylabel('订单量')\n",
    "# 在图上加数据标签\n",
    "for p in axes[1, 0].patches:\n",
    "    axes[1, 0].annotate(f'{int(p.get_height())}', (p.get_x() + p.get_width() / 2., p.get_height()),\n",
    "                        ha='center', va='bottom', fontsize=9)\n",
    "\n",
    "# ========== 分析4：核心关联分析（配送天数 vs 评分） ==========\n",
    "sns.boxplot(data=df_order_level, x='review_score', y='delivery_days', ax=axes[1, 1], palette='coolwarm')\n",
    "axes[1, 1].set_title('4. 核心分析：不同评分下的配送天数差异')\n",
    "axes[1, 1].set_xlabel('评分')\n",
    "axes[1, 1].set_ylabel('配送天数')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ========== 打印文字版业务结论 ==========\n",
    "print(\"=\"*50)\n",
    "print(\"📊 Step3 核心数据结论\")\n",
    "print(\"=\"*50)\n",
    "correlation = df_order_level['delivery_days'].corr(df_order_level['review_score'])\n",
    "print(f\"1. 配送天数与评分的相关系数: {correlation:.4f} (负数说明负相关，配送越久评分越低)\")\n",
    "print(\"\\n2. 不同评分对应的平均配送天数:\")\n",
    "print(df_order_level.groupby('review_score')['delivery_days'].mean())\n",
    "low_score = df_order_level[df_order_level['review_score'] <= 2]\n",
    "print(f\"\\n3. 低分订单（1-2分）特征:\")\n",
    "print(f\"   占比: {len(low_score) / len(df_order_level) * 100:.2f}%\")\n",
    "print(f\"   平均配送天数: {low_score['delivery_days'].mean():.1f} 天\")\n",
    "print(f\"   延迟送达的比例: {low_score['is_late'].mean() * 100:.1f}%\")\n",
    "print(f\"   而5分订单的平均配送天数仅为: {df_order_level[df_order_level['review_score']==5]['delivery_days'].mean():.1f} 天\")"
   ]
